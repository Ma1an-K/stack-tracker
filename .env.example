# Supabase project credentials
# Copy this file to .env and fill in your values.
# Never commit .env — it is gitignored.

VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<your-anon-key>

# Optional — used to build the edge function URL. Falls back to the project ref
# parsed out of VITE_SUPABASE_URL when unset.
VITE_SUPABASE_PROJECT_ID=<your-project-ref>

# Local admin only — put this in .env.local (git-ignored), never in .env.
# Read server-side by the Vite dev server; no VITE_ prefix so it never reaches
# the browser bundle.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional — store listings. When BOTH are set, install prompts show App Store
# and Google Play badges instead of the add-to-Home-Screen guide.
VITE_APP_STORE_URL=
VITE_PLAY_STORE_URL=
